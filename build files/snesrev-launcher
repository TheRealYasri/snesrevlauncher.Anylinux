# --------------------------------------------------------------- discovery

say "Scanning for ROMs in $DATA_ROOT"

Z3_ROM=$(find_rom "$HASH_Z3_US" zelda3.sfc Z3)
Z3_REDUX_ROM=$(find_rom "$HASH_Z3_REDUX" zelda3.redux.sfc Z3_REDUX)
Z3_DE_ROM=$(find_rom "$HASH_Z3_DE" zelda3.de.sfc Z3_DE)
Z3_FR_ROM=$(find_rom "$HASH_Z3_FR" zelda3.fr.sfc Z3_FR)
Z3_FRC_ROM=$(find_rom "$HASH_Z3_FRC" zelda3.fr-c.sfc Z3_FRC)
Z3_ES_ROM=$(find_rom "$HASH_Z3_ES" zelda3.es.sfc Z3_ES)
Z3_PL_ROM=$(find_rom "$HASH_Z3_PL" zelda3.pl.sfc Z3_PL)
Z3_PT_ROM=$(find_rom "$HASH_Z3_PT" zelda3.pt.sfc Z3_PT)
Z3_NL_ROM=$(find_rom "$HASH_Z3_NL" zelda3.nl.sfc Z3_NL)
Z3_SV_ROM=$(find_rom "$HASH_Z3_SV" zelda3.sv.sfc Z3_SV)

SM_ROM=$(find_rom "$HASH_SM" sm.smc SM)
SM_REDUX_ROM=$(find_rom "$HASH_SM_REDUX" sm.redux.smc SM_REDUX)

SMW_ROM=$(find_rom "$HASH_SMW" smw.sfc SMW)
SMAS_ROM=$(find_rom "$HASH_SMAS" smas.sfc SMAS)
SMB1_ROM=$(find_rom "$HASH_SMB1" smb1.sfc SMB1)
SMBLL_ROM=$(find_rom "$HASH_SMBLL" smbll.sfc SMBLL)

# ------------------------------------------------------------------ playable

PLAYABLE=
is_playable() {
	case $1 in
		z3|z3-redux) [ -n "$Z3_ROM" ] ;;
		sm|sm-redux) [ -n "$SM_ROM" ] ;;
		smw)		 [ -n "$SMW_ROM" ] ;;
		smb1|smbll)	 [ -n "$SMW_ROM" ] && { [ -n "$SMB1_ROM" ] || [ -n "$SMAS_ROM" ]; } ;;
		z3-de)		 [ -n "$Z3_ROM" ] && [ -n "$Z3_DE_ROM" ] ;;
		z3-fr)		 [ -n "$Z3_ROM" ] && [ -n "$Z3_FR_ROM" ] ;;
		z3-fr-c)	 [ -n "$Z3_ROM" ] && [ -n "$Z3_FRC_ROM" ] ;;
		z3-es)		 [ -n "$Z3_ROM" ] && [ -n "$Z3_ES_ROM" ] ;;
		z3-pl)		 [ -n "$Z3_ROM" ] && [ -n "$Z3_PL_ROM" ] ;;
		z3-pt)		 [ -n "$Z3_ROM" ] && [ -n "$Z3_PT_ROM" ] ;;
		z3-nl)		 [ -n "$Z3_ROM" ] && [ -n "$Z3_NL_ROM" ] ;;
		z3-sv)		 [ -n "$Z3_ROM" ] && [ -n "$Z3_SV_ROM" ] ;;
		*)			 return 1 ;;
	esac
}

while IFS= read -r entry; do
	[ -n "$entry" ] || continue
	is_playable "${entry%%|*}" && PLAYABLE="$PLAYABLE ${entry%%|*}"
done <<-EOF
$GAME_TABLE	
	EOF

# ------------------------------------------------------------------ patching

# patch_rom <source rom> <ips> <destination>
patch_rom() {
	[ -f "$3" ] && return 0
	say "Patching $(basename "$3") (this only happens once)"
	"$APPDIR/bin/flips" --apply "$2" "$1" "$3" >/dev/null 2>&1
	[ -f "$3" ]
}

# ---------------------------------------------------------------------- gui

gui_choose() {
	set --
	while IFS= read -r entry; do
		[ -n "$entry" ] || continue
		key=${entry%%|*}
		title=${entry#*|}
		if is_playable "$key"; then
			set -- "$@" "$key" "$title"
		else
			set -- "$@" "$key" "$title (Missing Files)"
		fi
	done <<-EOF
	$GAME_TABLE
	EOF

	if [ "$INSTALL_DESKTOP" = 1 ]; then
		set -- "$@" desktop "Desktop Shortcuts (Enabled)"
	else
		set -- "$@" desktop "Desktop Shortcuts (Disabled)"
	fi

	zenity --list --title="SNESREV Launcher" --height=600 --width=450 \
		--column="Cmd" --column="Game" --hide-header "$@" 2>/dev/null
}

# ------------------------------------------------------------------- launch

cmd=${1:-}
[ $# -gt 0 ] && shift

case $cmd in
	help)
		show_help
		exit 0
		;;
	desktop)
		toggle_desktop
		exit 0
		;;
	'')
		if command -v zenity >/dev/null 2>&1; then
			cmd=$(gui_choose)
			[ -n "$cmd" ] || exit 0
			GUI=1
		else
			show_help
			exit 0
		fi
		;;
esac

[ "$INSTALL_DESKTOP" = 1 ] && sync_desktops

case $cmd in
	z3|z3-en)
		zelda3 z3 us
		;;
	z3-redux)
		# either the user has a pre-patched dump or we build one from the
		# base ROM with the patch that ships in the AppImage
		if [ -z "$Z3_REDUX_ROM" ]; then
			patch_rom "$Z3_ROM" "$TOOLS/patches/z3.redux.ips" "$ROM_DIR/zelda3.redux.sfc" || exit 1
			Z3_REDUX_ROM=$ROM_DIR/zelda3.redux.sfc
		fi
		zelda3 z3-redux redux "$Z3_REDUX_ROM"
		;;
	z3-de|z3-fr|z3-fr-c|z3-es|z3-pl|z3-pt|z3-nl|z3-sv)
		lang=${cmd#z3-}
		rom=
		case $lang in
			de)	  rom=$Z3_DE_ROM ;;
			fr)	  rom=$Z3_FR_ROM ;;
			fr-c) rom=$Z3_FRC_ROM ;;
			es)	  rom=$Z3_ES_ROM ;;
			pl)	  rom=$Z3_PL_ROM ;;
			pt)	  rom=$Z3_PT_ROM ;;
			nl)	  rom=$Z3_NL_ROM ;;
			sv)	  rom=$Z3_SV_ROM ;;
		esac
		zelda3 "$cmd" "$lang" "$rom"
		;;
	sm)
		super_metroid sm "$SM_ROM"
		;;
	sm-redux)
		if [ -z "$SM_REDUX_ROM" ]; then
			patch_rom "$SM_ROM" "$TOOLS/patches/sm.redux.ips" "$ROM_DIR/sm.redux.smc" || exit 1
			SM_REDUX_ROM=$ROM_DIR/sm.redux.smc
		fi
		super_metroid sm-redux "$SM_REDUX_ROM"
		;;
	smw)
		super_mario_world smw "$SMW_ROM" smw.sfc
		;;
	smb1|smbll)
		if [ -z "${SMB1_ROM:-}" ] || [ -z "${SMBLL_ROM:-}" ]; then
			smb_roms || exit 1
			SMB1_ROM=$ROM_DIR/smb1.sfc
			SMBLL_ROM=$ROM_DIR/smbll.sfc
		fi
		if [ "$cmd" = smb1 ]; then
			super_mario_world smb1 "$SMB1_ROM" smb1.sfc
		else
			super_mario_world smbll "$SMBLL_ROM" smbll.sfc
		fi
		;;
	*)
		printf "Error: '%s' is not a valid command.\n\n" "$cmd" >&2
		show_help >&2
		exit 1
		;;
esac
