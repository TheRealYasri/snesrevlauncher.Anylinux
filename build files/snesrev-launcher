#!/bin/sh

# Launcher for the SNES reverse engineering PC ports:
# Zelda 3, Super Metroid, Super Mario World, plus their romhacks.
#
# ROMs are never shipped. The user drops their own dumps next to the AppImage,
# they are identified by sha1, renamed and cached. Game assets are extracted
# from those ROMs on first launch with the ports' own python tools.
#
# Everything the launcher writes lives in three directories next to the
# AppImage: srl-roms (the user's dumps), srl-config (per game config + assets)
# and srl-saves (per game save files). If that location is not writable (for
# example the AppImage lives in /usr/bin) it falls back to $XDG_DATA_HOME.

set -u

GAME_TABLE='z3|Zelda 3 (US)
z3-redux|Zelda 3 Redux
sm|Super Metroid
sm-redux|Super Metroid Redux
smw|Super Mario World
smb1|Super Mario Bros.
smbll|The Lost Levels
z3-de|Zelda 3 (German)
z3-fr|Zelda 3 (French)
z3-fr-c|Zelda 3 (French Can)
