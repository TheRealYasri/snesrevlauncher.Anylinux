say() { printf '>> %s\n' "$*" >&2; }
die() { printf 'Error: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------- locations

if [ -z "${APPDIR:-}" ]; then
	APPDIR=$(cd "$(dirname "$0")/.." && pwd) || exit 1
fi
TOOLS=$APPDIR/share/snesrev
SELF=${APPIMAGE:-$APPDIR/AppRun}

# Where the AppImage lives is where the user expects to drop ROMs.
if [ -n "${APPIMAGE:-}" ]; then
	DATA_ROOT=$(dirname "$(readlink -f "$APPIMAGE")")
else
	DATA_ROOT=$(dirname "$(readlink -f "$APPDIR")")
fi

if ! mkdir -p "$DATA_ROOT/srl-roms" 2>/dev/null || [ ! -w "$DATA_ROOT" ]; then
	DATA_ROOT=${XDG_DATA_HOME:-$HOME/.local/share}/snesrev-launcher
	say "Install location is read-only, using $DATA_ROOT instead"
	mkdir -p "$DATA_ROOT/srl-roms" || die "cannot create $DATA_ROOT"
fi

ROM_DIR=$DATA_ROOT/srl-roms
CFG_ROOT=$DATA_ROOT/srl-config
SAVE_ROOT=$DATA_ROOT/srl-saves
RUN_ROOT=$DATA_ROOT/srl-run
CFG_FILE=$CFG_ROOT/srl.ini

mkdir -p "$CFG_ROOT/icons" "$SAVE_ROOT" "$RUN_ROOT" || die "cannot create $DATA_ROOT"

# ------------------------------------------------------------------ config

# shellcheck disable=SC1090 # user config, not shipped in the AppImage
[ -f "$CFG_FILE" ] && . "$CFG_FILE"

set_cfg() {
	[ -f "$CFG_FILE" ] || : > "$CFG_FILE"
	grep -v "^$1=" "$CFG_FILE" > "$CFG_FILE.tmp" 2>/dev/null || :
	mv -f "$CFG_FILE.tmp" "$CFG_FILE"
	printf '%s="%s"\n' "$1" "$2" >> "$CFG_FILE"
}

INSTALL_DESKTOP=${INSTALL_DESKTOP:-0}
LAST_PATH=${LAST_PATH:-}
REFRESH_DESKTOP=${REFRESH_DESKTOP:-0}

if [ "$DATA_ROOT" != "$LAST_PATH" ]; then
	say "Data directory: $DATA_ROOT"
	set_cfg LAST_PATH "$DATA_ROOT"
	set_cfg REFRESH_DESKTOP 1
	LAST_PATH=$DATA_ROOT
	REFRESH_DESKTOP=1
fi

get_cfg() {
	eval "printf '%s\n' \"\${$1:-}\""
}

# Keep the shortcut icons in sync with the ones shipped in the AppImage so the
# .desktop files can point at a stable path even when the AppImage moves.
sync_icons() {
	for i in z3 sm smw; do
		src=$TOOLS/icons/$i.png
		dst=$CFG_ROOT/icons/$i.png
		[ -f "$src" ] || continue
		[ -f "$dst" ] && [ "$(stat -c %Y "$src")" = "$(get_cfg "CACHE_ICON_${i}_TIME")" ] && continue
		cp -f "$src" "$dst" || continue
		set_cfg "CACHE_ICON_${i}_TIME" "$(stat -c %Y "$src")"
	done
}

sync_icons

# ------------------------------------------------------------- rom finding
# sha1 of a file, using the host tool when there is one and the bundled python
# otherwise, so this works on a system that has neither
sha1_of() {
	if [ -n "$HASHER" ]; then
		"$HASHER" "$1" | awk '{print $1}'
	else
		"$APPDIR/bin/python3" -c 'import hashlib,sys
print(hashlib.sha1(open(sys.argv[1], "rb").read()).hexdigest())' "$1"
	fi
}

if command -v sha1sum >/dev/null 2>&1; then
	HASHER=sha1sum
elif command -v shasum >/dev/null 2>&1; then
	HASHER=shasum
else
	HASHER=
fi

rom_cache_set() {
	set_cfg "CACHE_$1_PATH" "$2"
	set_cfg "CACHE_$1_TIME" "$3"
}

# find_rom <sha1|sha1|..> <canonical name> <cache key>
# Prints the path of the matching dump, renaming it to <canonical name> in
# $ROM_DIR so the rest of the launcher has a predictable file to work with.
find_rom() {
	hashes=$1
	name=$2
	key=$3

	cached=$(get_cfg "CACHE_${key}_PATH")
	if [ -n "$cached" ] && [ -f "$cached" ] &&
		[ "$(stat -c %Y "$cached" 2>/dev/null)" = "$(get_cfg "CACHE_${key}_TIME")" ]; then
		printf '%s\n' "$cached"
		return 0
	fi

	if [ -f "$ROM_DIR/$name" ] &&
		sha1_of "$ROM_DIR/$name" | grep -iqE "^($hashes)"; then
		rom_cache_set "$key" "$ROM_DIR/$name" "$(stat -c %Y "$ROM_DIR/$name")"
		printf '%s\n' "$ROM_DIR/$name"
		return 0
	fi

	for f in "$DATA_ROOT"/*.sfc "$DATA_ROOT"/*.smc "$ROM_DIR"/*.sfc "$ROM_DIR"/*.smc; do
		[ -f "$f" ] || continue
		[ "$f" = "$ROM_DIR/$name" ] && continue
		sha1_of "$f" | grep -iqE "^($hashes)" || continue
		say "Found $(basename "$f"), moving it to $ROM_DIR/$name"
		mv -f "$f" "$ROM_DIR/$name" || continue
		rom_cache_set "$key" "$ROM_DIR/$name" "$(stat -c %Y "$ROM_DIR/$name")"
		printf '%s\n' "$ROM_DIR/$name"
		return 0
	done

	return 0
}

# ----------------------------------------------------------- asset helpers

# make_workdir <port dir under share/snesrev/tools> -> temp dir holding a
# writable copy of that port's asset tools
make_workdir() {
	w=$(mktemp -d "${TMPDIR:-/tmp}/snesrev-$1.XXXXXX") || return 1
	cp -R "$TOOLS/tools/$1/." "$w/" || { rm -rf "$w"; return 1; }
	printf '%s\n' "$w"
}

# zelda3_assets <game key> <language> [translation rom]
# Builds $CFG_ROOT/<key>/zelda3_assets.dat. Every Zelda variant shares the US
# ROM; translations and Redux only replace the dialogue set baked into the
# assets file, which is why they get their own .dat.
zelda3_assets() {
	key=$1
	lang=$2
	trans=${3:-}
	dest=$CFG_ROOT/$key

	[ -f "$dest/zelda3_assets.dat" ] && return 0
	[ -n "${Z3_ROM:-}" ] || { say "the Zelda 3 (US) ROM is required to build the assets"; return 1; }

	say "Extracting Zelda 3 assets for '$key' (this only happens once)"
	w=$(make_workdir zelda3) || return 1
	# restool.py chdirs into assets/, which is where the dialogue and font
	# files it generates go, while the ROMs it reads and the .dat it writes
	# sit one level above
	cp -f "$Z3_ROM" "$w/zelda3.sfc" || { rm -rf "$w"; return 1; }
	if [ -n "$trans" ]; then
		cp -f "$trans" "$w/translate.sfc" || { rm -rf "$w"; return 1; }
	fi

	(
		cd "$w" || exit 1
		"$APPDIR/bin/python3" assets/restool.py --extract-from-rom || exit 1
		if [ "$lang" != us ]; then
			"$APPDIR/bin/python3" assets/restool.py --extract-dialogue -r translate.sfc || exit 1
			"$APPDIR/bin/python3" assets/restool.py --languages="$lang" || exit 1
		fi
	) || { rm -rf "$w"; say "Asset extraction failed"; return 1; }

	if [ ! -f "$w/zelda3_assets.dat" ]; then
		rm -rf "$w"
		say "Asset extraction produced no zelda3_assets.dat"
		return 1
	fi

	mkdir -p "$dest" || { rm -rf "$w"; return 1; }
	mv -f "$w/zelda3_assets.dat" "$dest/zelda3_assets.dat" || { rm -rf "$w"; return 1; }
	rm -rf "$w"
	return 0
}
# smw_assets <game key> <rom to extract from>
# Super Mario World, SMB1 and The Lost Levels all run on the smw executable and
# all need smw_assets.dat, so the Super Mario World ROM is the one extracted.
smw_assets() {
	key=$1
	rom=$2
	dest=$CFG_ROOT/$key

	[ -f "$dest/smw_assets.dat" ] && return 0
	[ -n "$rom" ] || { say "the Super Mario World ROM is required to build the assets"; return 1; }

	say "Extracting Super Mario World assets for '$key' (this only happens once)"
	w=$(make_workdir smw) || return 1
	cp -f "$rom" "$w/assets/smw.sfc" || { rm -rf "$w"; return 1; }

	( cd "$w" && "$APPDIR/bin/python3" assets/restool.py --extract-from-rom -r smw.sfc ) || {
		rm -rf "$w"; say "Asset extraction failed"; return 1
	}

	if [ ! -f "$w/smw_assets.dat" ]; then
		rm -rf "$w"
		say "Asset extraction produced no smw_assets.dat"
		return 1
	fi

	mkdir -p "$dest" || { rm -rf "$w"; return 1; }
	mv -f "$w/smw_assets.dat" "$dest/smw_assets.dat" || { rm -rf "$w"; return 1; }
	rm -rf "$w"
	return 0
}

# smb_roms: Super Mario Bros. and The Lost Levels are carved out of the Super
# Mario All-Stars ROM with the dictionary shipped in the smw source tree.
smb_roms() {
	[ -n "${SMAS_ROM:-}" ] || { say "the Super Mario All-Stars ROM is required for this game"; return 1; }

    say "Extracting Super Mario Bros. and The Lost Levels from All-Stars"
    w=$(make_workdir smw) || return 1
    # extract.py opens smas.sfc and both zstd dictionaries from the current
    # directory and writes the two ROMs there as well, so it has to run from
    # the workdir root with the dictionaries copied next to it, not from the
    # directory the script happens to live in
    cp -f "$SMAS_ROM" "$w/smas.sfc" || { rm -rf "$w"; return 1; }
    cp -f "$w/other/smb1.zst" "$w/other/smbll.zst" "$w/" || { rm -rf "$w"; return 1; }

    ( cd "$w" && "$APPDIR/bin/python3" other/extract.py ) || { rm -rf "$w"; say "Extraction failed"; return 1; }

    if [ ! -f "$w/smb1.sfc" ] || [ ! -f "$w/smbll.sfc" ]; then
        rm -rf "$w"
        say "Extraction produced no ROMs"
        return 1
    fi

    mv -f "$w/smb1.sfc" "$ROM_DIR/smb1.sfc" || { rm -rf "$w"; return 1; }
    mv -f "$w/smbll.sfc" "$ROM_DIR/smbll.sfc" || { rm -rf "$w"; return 1; }
    rm -rf "$w"

	rom_cache_set SMB1 "$ROM_DIR/smb1.sfc" "$(stat -c %Y "$ROM_DIR/smb1.sfc")"
	rom_cache_set SMBLL "$ROM_DIR/smbll.sfc" "$(stat -c %Y "$ROM_DIR/smbll.sfc")"
	return 0
}

# ------------------------------------------------------------- game running

ensure_ini() {
	# $1 game key, $2 ini name, $3 default ini shipped in the AppImage
	mkdir -p "$CFG_ROOT/$1" || return 1
	[ -f "$CFG_ROOT/$1/$2" ] || cp -f "$3" "$CFG_ROOT/$1/$2" || return 1
}

# run_game <game key> <binary in $APPDIR/bin> <ini name> <rom link name> <rom path> [rom arg]
# Every game gets its own working directory holding symlinks to that game's
# config, assets, ROM and saves, and the port is started inside it, because the
# ports resolve all of their files relative to the current directory.
run_game() {
	key=$1
	bin=$2
	ini=$3
	romname=$4
	rom=$5
	romarg=${6:-}

	cfg=$CFG_ROOT/$key
	saves=$SAVE_ROOT/$key
	run=$RUN_ROOT/$key

	mkdir -p "$cfg" "$saves" || return 1
	rm -rf "$run"
	mkdir -p "$run" || return 1

	ln -sfn "$saves" "$run/saves"
	[ -f "$cfg/$ini" ] && ln -sfn "$cfg/$ini" "$run/$ini"
	[ -f "$cfg/zelda3_assets.dat" ] && ln -sfn "$cfg/zelda3_assets.dat" "$run/zelda3_assets.dat"
	[ -f "$cfg/smw_assets.dat" ] && ln -sfn "$cfg/smw_assets.dat" "$run/smw_assets.dat"
	[ -n "$rom" ] && ln -sfn "$rom" "$run/$romname"

	say "Starting $key (config: $cfg, saves: $saves)"
	if [ -n "$romarg" ]; then
		( cd "$run" && exec "$APPDIR/bin/$bin" "$romarg" )
	else
		( cd "$run" && exec "$APPDIR/bin/$bin" )
	fi
}

# zelda3 <game key> <language> [translation rom]
zelda3() {
	key=$1
	lang=$2
	trans=${3:-}

	[ -n "${Z3_ROM:-}" ] || die "no Zelda 3 (US) ROM found, drop one next to the AppImage"
	if [ "$lang" != us ] && [ "$lang" != redux ] && [ -z "$trans" ]; then
		die "no $lang translation ROM found, $key needs both the US and the $lang dump"
	fi
	zelda3_assets "$key" "$lang" "$trans" || exit 1

	ensure_ini "$key" zelda3.ini "$TOOLS/tools/zelda3/zelda3.ini" || exit 1
	if [ "$lang" != us ]; then
		sed -i -e 's/^# *Language/Language/' \
			   -e "s/^Language *=.*/Language = $lang/" "$CFG_ROOT/$key/zelda3.ini"
	fi

	# the assets file already carries the dialogue and the graphics, the ROM is
	# only the fallback the port uses when it has to build them itself
	run_game "$key" zelda3 zelda3.ini zelda3.sfc "$Z3_ROM" || exit 1
}

super_metroid() {
	key=$1
	rom=$2

	[ -n "$rom" ] || die "no ROM found for $key, drop one next to the AppImage"
	ensure_ini "$key" sm.ini "$TOOLS/tools/sm/sm.ini" || exit 1

	run_game "$key" "$key" sm.ini sm.smc "$rom" sm.smc || exit 1
}

super_mario_world() {
	key=$1
	rom=$2
	romname=$3

	[ -n "$rom" ] || die "no ROM found for $key, drop one next to the AppImage"
	[ -n "${SMW_ROM:-}" ] || die "no Super Mario World ROM found, it is needed for the assets"

	smw_assets "$key" "$SMW_ROM" || exit 1
	ensure_ini "$key" smw.ini "$TOOLS/tools/smw/smw.ini" || exit 1

	run_game "$key" smw smw.ini "$romname" "$rom" "$romname" || exit 1
}

# --------------------------------------------------------- desktop entries

desktop_dir=${XDG_DATA_HOME:-$HOME/.local/share}/applications

desktop_icon() {
	case $1 in
		z3*)		 echo "$CFG_ROOT/icons/z3.png" ;;
		sm|sm-redux) echo "$CFG_ROOT/icons/sm.png" ;;
		*)			 echo "$CFG_ROOT/icons/smw.png" ;;
	esac
}

install_desktop() {
	key=$1
	title=$2
	mkdir -p "$desktop_dir" || return 1

	icon=$(desktop_icon "$key")
	[ -f "$icon" ] || icon=utilities-terminal

	say "Writing shortcut: $title"
	cat > "$desktop_dir/SRL-$title.desktop" <<-EOF
	[Desktop Entry]
	Type=Application
	Name=SRL-$title
	Exec="$SELF" $key
	Path=$DATA_ROOT
	Icon=$icon
	Terminal=false
	Categories=Game;
	StartupNotify=false
		EOF
	chmod +x "$desktop_dir/SRL-$title.desktop"
}

remove_all_desktops() {
	for f in "$desktop_dir"/SRL-*.desktop; do
		[ -e "$f" ] || continue
		rm -f "$f"
	done
	say "All desktop shortcuts removed"
}
sync_desktops() {
	for key in $PLAYABLE; do
		while IFS= read -r entry; do
			[ -n "$entry" ] || continue
			[ "${entry%%|*}" = "$key" ] || continue
			file=$desktop_dir/SRL-${entry#*|}.desktop
			if [ "$REFRESH_DESKTOP" = 1 ] || [ ! -f "$file" ]; then
				install_desktop "$key" "${entry#*|}"
			fi
		done <<-EOF
		$GAME_TABLE
			EOF
	done

	# drop shortcuts of games whose files went missing
	for f in "$desktop_dir"/SRL-*.desktop; do
		[ -e "$f" ] || continue
		name=${f##*/SRL-}
		name=${name%.desktop}
		found=0
		for key in $PLAYABLE; do
			while IFS= read -r entry; do
				[ "${entry#*|}" = "$name" ] && found=1
			done <<-EOF
			$GAME_TABLE
				EOF
		done
		[ "$found" = 1 ] && continue
		say "Removing obsolete shortcut: $name"
		rm -f "$f"
	done

	[ "$REFRESH_DESKTOP" = 1 ] && set_cfg REFRESH_DESKTOP 0
	return 0
}

toggle_desktop() {
	if [ "$INSTALL_DESKTOP" = 1 ]; then
		INSTALL_DESKTOP=0
		remove_all_desktops
		state=Disabled
	else
		INSTALL_DESKTOP=1
		REFRESH_DESKTOP=1
		sync_desktops
		state=Enabled
	fi
	set_cfg INSTALL_DESKTOP "$INSTALL_DESKTOP"
	say "Desktop shortcuts: $state"
	if [ "${GUI:-}" = 1 ] && command -v zenity >/dev/null 2>&1; then
		zenity --info --text="Desktop shortcuts: $state" --timeout=2
		exec "$0"
	fi
}

